# TEMPLATE — copie para 02-secret.yaml, preencha com valores reais e NUNCA
# commite o arquivo preenchido (02-secret.yaml está no .gitignore).
#
# Alternativa recomendada em produção: gerar via linha de comando, sem deixar
# o segredo em nenhum arquivo em disco:
#   kubectl create secret generic oficina-app-secret -n oficina \
#     --from-literal=DB_USERNAME=oficina \
#     --from-literal=DB_PASSWORD='<senha-forte>' \
#     --from-literal=JWT_SECRET='<segredo-forte>'
apiVersion: v1
kind: Secret
metadata:
  name: oficina-app-secret
  namespace: oficina
type: Opaque
stringData:
  DB_USERNAME: 'oficina'
  DB_PASSWORD: 'troque-esta-senha'
  JWT_SECRET: 'troque-por-um-segredo-forte-em-producao'
