# Aplicação
PORT=3000
NODE_ENV=development

# JWT
JWT_SECRET=troque-por-um-segredo-forte-em-producao
JWT_EXPIRES_IN=1h

# Banco de dados (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=oficina
DB_PASSWORD=oficina
DB_DATABASE=oficina

# E-mail (notificação de mudança de status da OS)
# Local/dev: aponta para o Mailhog do docker-compose (captura tudo, sem enviar de verdade).
# UI do Mailhog: http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=oficina@example.com

# Usuário administrativo inicial (usado pelo script npm run seed:admin)
ADMIN_EMAIL=admin@oficina.com
ADMIN_PASSWORD=admin123
ADMIN_NOME=Administrador

# Observabilidade (Fase 3) — desligado por padrão em dev local/CI.
# Ative em produção/demo com uma conta Datadog configurada.
DD_TRACE_ENABLED=false
DD_ENV=development
DD_SERVICE=oficina-tech-challenge
