# TEMPLATE — não commite preenchido. Em produção, a pipeline de CI/CD gera
# este Secret dinamicamente a partir do SSM Parameter Store (JWT_SECRET
# publicado pelo oficina-lambda-auth, DB_USERNAME/DB_PASSWORD publicados pelo
# oficina-infra-db) — ver .github/workflows/ci-cd.yml. Este arquivo é só
# referência para quem quiser aplicar manualmente:
#
#   kubectl create secret generic oficina-app-secret -n oficina \
#     --from-literal=DB_USERNAME="$(aws ssm get-parameter --name /oficina/db_username --with-decryption --query Parameter.Value --output text)" \
#     --from-literal=DB_PASSWORD="$(aws ssm get-parameter --name /oficina/db_password --with-decryption --query Parameter.Value --output text)" \
#     --from-literal=JWT_SECRET="$(aws ssm get-parameter --name /oficina/jwt_secret --with-decryption --query Parameter.Value --output text)"
apiVersion: v1
kind: Secret
metadata:
  name: oficina-app-secret
  namespace: oficina
type: Opaque
stringData:
  DB_USERNAME: 'oficina'
  DB_PASSWORD: 'preenchido-pela-pipeline'
  JWT_SECRET: 'preenchido-pela-pipeline'
